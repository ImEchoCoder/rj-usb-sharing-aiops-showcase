# .env.example — placeholder only. Copy to .env and fill in locally; never commit .env.
# The showcase repo documents WHICH env vars the real system needs, never their values.
# All tokens below are OBVIOUSLY FAKE — nothing here is a real credential.

# LLM providers (production uses OpenRouter primary, Gemini fallback)
OPENROUTER_API_KEY=sk-or-FAKE-KEY-REPLACE-ME
GEMINI_API_KEY=AIza-FAKE-KEY-REPLACE-ME

# ChatOps
TELEGRAM_BOT_TOKEN=000000000:FAKE-TELEGRAM-TOKEN-REPLACE-ME
TELEGRAM_ALLOWED_USER_ID=0

# Remote targets (no real hostnames published — fill in locally)
OBS_HOST=change-me.local
PROD_HOST=change-me.local

# Storage / infra
OBS_WORKSPACE=/change/me